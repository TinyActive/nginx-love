# Nginx Love — Docker Compose environment
# Copy to .env: cp .env.docker.example .env

# Database (aligned with legacy deploy.sh naming)
DB_NAME=nginx_love_db
DB_USER=nginx_love_user
DB_PASSWORD=change_this_to_a_secure_password
DB_PORT=5432

# Used by backend service (hostname = postgres service name)
DATABASE_URL=postgresql://nginx_love_user:change_this_to_a_secure_password@postgres:5432/nginx_love_db?schema=public

# API (internal — not published to host; access via :8080/api proxy)
API_PORT=3001
NODE_ENV=production

# Proxy-only mode — no CORS configuration needed
API_BEHIND_PROXY=true
DISABLE_CORS=true

# Security — generate unique values for production
JWT_ACCESS_SECRET=change-this-to-random-secret
JWT_REFRESH_SECRET=change-this-to-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-random-secret
BCRYPT_ROUNDS=10

# Frontend: relative /api — works with any host/IP via nginx proxy on port 8080
VITE_API_URL=/api
WEB_PORT=8080

# SSL / ACME paths inside backend container
SSL_DIR=/etc/nginx/ssl
ACME_DIR=/var/www/html/.well-known/acme-challenge

# Optional: Docker Hub image tag when using docker-compose.pull.yml
# IMAGE_TAG=latest
# DOCKERHUB_USER=your-dockerhub-user

# Optional: debug direct API on localhost:3001 (re-enables CORS)
# docker compose -f docker-compose.yml -f docker-compose.expose-api.yml up -d

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-this-to-random-password

TWO_FACTOR_APP_NAME=Nginx Love Admin
