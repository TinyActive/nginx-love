ARG BASE_IMAGE=nginx-love-base:latest

# Production stage — Node API builder
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN pnpm --filter @nginx-love/shared build

RUN cd apps/api && pnpm prisma:generate
RUN pnpm --filter @nginx-love/api build

# Runtime — nginx + ModSecurity + Node API
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y curl ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs openssl apache2-utils wget && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g corepack && corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY scripts ./scripts
COPY config/nginx.conf /app/config/nginx.conf
COPY VERSION /app/VERSION

RUN pnpm install --frozen-lockfile --filter @nginx-love/api
RUN cd apps/api && pnpm prisma:generate

RUN cd /tmp && \
    wget -O acme.sh.tar.gz https://github.com/acmesh-official/acme.sh/archive/master.tar.gz && \
    tar -xzf acme.sh.tar.gz && \
    cd acme.sh-master && \
    ./acme.sh --install --force --home /root/.acme.sh && \
    ln -sf /root/.acme.sh/acme.sh /usr/local/bin/acme.sh && \
    rm -rf /tmp/acme.sh*

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PROJECT_ROOT=/app
ENV APP_VERSION=2.2.0
ENV SKIP_NGINX_INSTALL=true
ENV NODE_ENV=production

EXPOSE 80 443 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
